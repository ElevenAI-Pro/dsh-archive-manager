{
  "name": "dsh-archive-manager",
  "version": "0.6.0",
  "description": "Real session deletion for DeepSeek Harness: settings-page manager with trash & restore + sidebar permanent delete (Codex style) + auto-archive with retention (zcodex style). Fork of xohmai/dsh-session-delete.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElevenAI-Pro/dsh-archive-manager.git"
  },
  "homepage": "https://github.com/ElevenAI-Pro/dsh-archive-manager#readme",
  "bugs": "https://github.com/ElevenAI-Pro/dsh-archive-manager/issues",
  "author": "Eleven_AI <ElevenAI-Pro@users.noreply.github.com>",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "tools",
    "cordis.patch.yml",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/render.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
